# Copy these into Railway → Service → Variables
# Same pattern as ECMS (MYSQL_* + Jwt + Cors + FileStorage)

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:8080

MYSQL_HOST=h5g5-db.hstgr.io
MYSQL_PORT=3306
MYSQL_DATABASE=u910121167_61mLrRkFt_OV2
MYSQL_USER=u910121167_61mLrRkFt_OV2
MYSQL_PASSWORD=

Jwt__Key=
Jwt__Issuer=Optimus.V2
Jwt__Audience=Optimus.V2.Client
Jwt__AccessTokenMinutes=30
Jwt__RefreshTokenDays=14

Cors__Origins__0=https://indigo-buffalo-715579.hostingersite.com
Cors__Origins__1=https://www.indigo-buffalo-715579.hostingersite.com

FileStorage__UploadPath=uploads

# Email (Railway Hobby blocks outbound SMTP ports 465/587 — use Resend on Hobby)
# 1. Create free account at https://resend.com and verify your domain (tnsds.ph)
# 2. Add DNS records Resend provides, then create an API key
Resend__ApiKey=

# From-address (used by Resend and SMTP)
Smtp__Host=smtp.hostinger.com
Smtp__Port=465
Smtp__User=
Smtp__Password=
Smtp__FromEmail=
Smtp__FromName=OPTIMUS
Smtp__UseSsl=true
# SMTP password only needed for local dev or Railway Pro plan

App__PublicUrl=https://indigo-buffalo-715579.hostingersite.com

# Optional — leave empty to use in-memory cache
# ConnectionStrings__Redis=

# Frontend build (Hostinger or Railway static service) — not used by API
# VITE_API_BASE_URL=https://YOUR-SERVICE.up.railway.app
