FROM mcr.microsoft.com/dotnet/sdk:7.0 AS build
WORKDIR /src
COPY src/ ./src/
COPY Optimus.V2.sln ./
RUN dotnet restore src/Optimus.Api/Optimus.Api.csproj
RUN dotnet publish src/Optimus.Api/Optimus.Api.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:7.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .
COPY scripts/railway-predeploy.sh /app/railway-predeploy.sh
RUN chmod +x /app/railway-predeploy.sh && mkdir -p /app/uploads
ENV ASPNETCORE_URLS=http://0.0.0.0:8080
EXPOSE 8080
ENTRYPOINT ["/bin/sh", "-c", "exec dotnet Optimus.Api.dll --urls \"http://0.0.0.0:${PORT:-8080}\""]
